<mxfile host="drawio"><diagram name="Architecture IA"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1000" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:18px'&gt;EchoLens — architecture IA : du son au résultat&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555555'&gt;De gauche à droite, le trajet d'un audio dans l'application ; en bas, comment les modèles sont entraînés, évalués et choisis. Scores : F1 macro de test (training/results/). En gris pointillé : prévu ou non appliqué.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c3" value="1. Données" style="swimlane;html=1;startSize=40;fontStyle=1;container=1;collapsible=0;fillColor=#E3EAF3;strokeColor=#5B6B7F;swimlaneFillColor=#FAFBFD;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="85" width="250" height="585" as="geometry"/></mxCell><mxCell id="c4" value="2. Prétraitement&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;core.audio&lt;/span&gt;" style="swimlane;html=1;startSize=40;fontStyle=1;container=1;collapsible=0;fillColor=#E3EAF3;strokeColor=#5B6B7F;swimlaneFillColor=#FAFBFD;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="85" width="250" height="585" as="geometry"/></mxCell><mxCell id="c5" value="3. Représentations&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;core.features (R5)&lt;/span&gt;" style="swimlane;html=1;startSize=40;fontStyle=1;container=1;collapsible=0;fillColor=#E3EAF3;strokeColor=#5B6B7F;swimlaneFillColor=#FAFBFD;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="85" width="260" height="585" as="geometry"/></mxCell><mxCell id="c6" value="4. Modèles&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;core.models&lt;/span&gt;" style="swimlane;html=1;startSize=40;fontStyle=1;container=1;collapsible=0;fillColor=#E3EAF3;strokeColor=#5B6B7F;swimlaneFillColor=#FAFBFD;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="85" width="360" height="585" as="geometry"/></mxCell><mxCell id="c7" value="5. Sortie&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px'&gt;services, puis l'interface&lt;/span&gt;" style="swimlane;html=1;startSize=40;fontStyle=1;container=1;collapsible=0;fillColor=#E3EAF3;strokeColor=#5B6B7F;swimlaneFillColor=#FAFBFD;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="85" width="270" height="585" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Émotions&lt;/b&gt;&lt;br&gt;CREMA-D (7 442) + RAVDESS (1 440)&lt;br&gt;&lt;i&gt;découpage par acteur (P1)&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFF8E6;strokeColor=#8A6D1F;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c3"><mxGeometry x="15" y="55" width="220" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Événements&lt;/b&gt;&lt;br&gt;ESC-50 (2 000 extraits)&lt;br&gt;&lt;i&gt;5 folds officiels (P3)&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFF8E6;strokeColor=#8A6D1F;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c3"><mxGeometry x="15" y="150" width="220" height="75" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Hors domaine&lt;/b&gt;&lt;br&gt;CaFE (émotions en français)&lt;br&gt;OpenSLR 57 (transcription)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFF8E6;strokeColor=#8A6D1F;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c3"><mxGeometry x="15" y="240" width="220" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Nos enregistrements&lt;/b&gt;&lt;br&gt;&lt;i&gt;test seulement, consentement (P13)&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFF8E6;strokeColor=#8A6D1F;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c3"><mxGeometry x="15" y="335" width="220" height="65" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Audio de l'utilisateur&lt;/b&gt;&lt;br&gt;fichier ou micro" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c3"><mxGeometry x="15" y="470" width="220" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Décodage ffmpeg&lt;/b&gt;&lt;br&gt;mono, 16 kHz, float32 (D1, D2)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c4"><mxGeometry x="15" y="50" width="220" height="60" as="geometry"/></mxCell><mxCell id="c14" value="Normalisation RMS (D3), débruitage (D4)&lt;br&gt;&lt;i&gt;dans core, non appliqués à l'inférence&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;dashed=1;dashPattern=6 4;strokeColor=#8A8A8A;fontColor=#6E6E6E;" vertex="1" parent="c4"><mxGeometry x="15" y="125" width="220" height="70" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Détection de parole&lt;/b&gt;&lt;br&gt;Silero VAD, seuils 0,40 / 0,25 (D5)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c4"><mxGeometry x="15" y="210" width="220" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Découpage&lt;/b&gt; (D5, D8)&lt;br&gt;événements : fenêtres de 5 s, 50 %&lt;br&gt;émotions : parole, 5 s au plus&lt;br&gt;micro : 2 s, décalage 0,5 s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c4"><mxGeometry x="15" y="290" width="220" height="95" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;log-Mel&lt;/b&gt;&lt;br&gt;64 bandes HTK, dB absolus&lt;br&gt;fenêtre 25 ms, pas 10 ms (R1, R2)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c5"><mxGeometry x="15" y="50" width="230" height="75" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Standardisation par bande&lt;/b&gt;&lt;br&gt;statistiques du train (R4)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c5"><mxGeometry x="15" y="145" width="230" height="60" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;MFCC 40 + Δ + ΔΔ&lt;/b&gt;&lt;br&gt;moyenne, écart-type (R3)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c5"><mxGeometry x="15" y="225" width="230" height="60" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Signal brut 16 kHz&lt;/b&gt;&lt;br&gt;sans Mel (R7)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c5"><mxGeometry x="15" y="310" width="230" height="60" as="geometry"/></mxCell><mxCell id="c21" value="Même code à l'entraînement (Kaggle) et dans l'application : le modèle voit exactement les mêmes entrées." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#555555;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c5"><mxGeometry x="15" y="400" width="230" height="80" as="geometry"/></mxCell><mxCell id="c22" value="Quatre approches comparées sur les mêmes données et le même protocole." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#555555;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c6"><mxGeometry x="15" y="50" width="330" height="50" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Famille A&lt;/b&gt; — réseaux appris sur le log-Mel&lt;br&gt;CNN : 4 blocs Conv → BatchNorm → ReLU → MaxPool&lt;br&gt;CRNN : mêmes blocs + BiGRU + pooling par attention&lt;br&gt;&lt;i&gt;ESC-50 : CRNN 0,83 (CNN 0,78) · émotions : CRNN 0,67 (CNN 0,62)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F3E3;strokeColor=#3E6B2F;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c6"><mxGeometry x="15" y="130" width="330" height="100" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Référence&lt;/b&gt; — MFCC + SVM (noyau RBF)&lt;br&gt;&lt;i&gt;ESC-50 : 0,40&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c6"><mxGeometry x="15" y="240" width="330" height="50" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Famille B&lt;/b&gt; — encodeur pré-entraîné gelé&lt;br&gt;Whisper base · mHuBERT-147 · wav2vec 2.0&lt;br&gt;→ somme pondérée apprise des couches → moyenne → MLP&lt;br&gt;&lt;i&gt;émotions : Whisper 0,75 (mHuBERT 0,77) · ESC-50 : Whisper 0,83&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6EEFA;strokeColor=#2C4F8A;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c6"><mxGeometry x="15" y="300" width="330" height="100" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Transcription&lt;/b&gt; — faster-whisper int8, français&lt;br&gt;&lt;i&gt;WER test : base 0,28 · small 0,14&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c6"><mxGeometry x="15" y="410" width="330" height="55" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Locuteur&lt;/b&gt; — ECAPA-TDNN, similarité cosinus&lt;br&gt;&lt;i&gt;en cours (C15)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;dashed=1;dashPattern=6 4;strokeColor=#8A8A8A;fontColor=#6E6E6E;" vertex="1" parent="c6"><mxGeometry x="15" y="475" width="330" height="50" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Calibration&lt;/b&gt; (E2, ENF-06)&lt;br&gt;p = softmax(z / T)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c7"><mxGeometry x="15" y="130" width="240" height="60" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Résultat global&lt;/b&gt; (C13)&lt;br&gt;événements : moyenne des fenêtres&lt;br&gt;émotions : moyenne pondérée&lt;br&gt;par la durée" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c7"><mxGeometry x="15" y="210" width="240" height="85" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Résultat JSON&lt;/b&gt;&lt;br&gt;une carte par tâche + segments" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF1E7;strokeColor=#B4400F;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c7"><mxGeometry x="15" y="315" width="240" height="55" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Interface&lt;/b&gt;&lt;br&gt;barres, frise, spectrogramme" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c7"><mxGeometry x="15" y="390" width="240" height="55" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Explicabilité&lt;/b&gt; (E7)&lt;br&gt;Grad-CAM (A) · poids des couches (B)&lt;br&gt;&lt;i&gt;Grad-CAM : en cours (C14)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;dashed=1;dashPattern=6 4;strokeColor=#8A8A8A;fontColor=#6E6E6E;" vertex="1" parent="c7"><mxGeometry x="15" y="465" width="240" height="70" as="geometry"/></mxCell><mxCell id="c33" value="Entraînement, évaluation et choix des modèles — Kaggle (GPU T4), puis Hugging Face" style="swimlane;html=1;startSize=40;fontStyle=1;container=1;collapsible=0;fillColor=#E3EAF3;strokeColor=#5B6B7F;swimlaneFillColor=#FAFBFD;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="715" width="1510" height="175" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Entraînement&lt;/b&gt;&lt;br&gt;AdamW, cosinus, courbe complète&lt;br&gt;meilleure époque sur la validation&lt;br&gt;3 graines (ESC-50 : 5 tours)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c33"><mxGeometry x="20" y="60" width="320" height="95" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Évaluation&lt;/b&gt; (E1 à E6)&lt;br&gt;F1 macro + IC bootstrap, McNemar (P8)&lt;br&gt;calibration ECE, latence p50 / p95, RTF&lt;br&gt;3 niveaux de test (P7)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c33"><mxGeometry x="390" y="60" width="330" height="95" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Publication&lt;/b&gt; (I7)&lt;br&gt;Hugging Face : model.safetensors&lt;br&gt;+ config.json (classes, T, stats R4)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c33"><mxGeometry x="770" y="60" width="300" height="95" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Registre&lt;/b&gt; configs/registry.yaml (S1)&lt;br&gt;qualité : têtes Whisper (B)&lt;br&gt;temps réel : CRNN (A), RTF &amp;lt; 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F3A48;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="c33"><mxGeometry x="1120" y="60" width="360" he