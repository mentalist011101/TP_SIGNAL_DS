<mxfile host="drawio"><diagram name="MCD"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1250" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:18px'&gt;EchoLens — MCD MERISE de l'historique des analyses&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555555'&gt;Rectangle = entité (# = identifiant) ; ellipse = association (ses attributs sous son nom) ; 1,n = cardinalité, lue du côté de l'entité ; (1,1) entre parenthèses = identification relative. En gris pointillé : prévu.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1250" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style='text-align:center'&gt;&lt;b&gt;ANALYSE&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;# id_analyse&lt;br&gt;date_creation&lt;br&gt;nom_fichier_original&lt;br&gt;statut&lt;br&gt;message_erreur&lt;br&gt;duree_s&lt;br&gt;profil" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#2F3A48;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="210" height="175" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style='text-align:center'&gt;&lt;b&gt;TÂCHE&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;# code_tache&lt;br&gt;libelle" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#2F3A48;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="170" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style='text-align:center'&gt;&lt;b&gt;MODÈLE&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;# id_modele&lt;br&gt;famille" 