# Copier en .env et compléter. Ne jamais commiter le fichier .env (dépôt public).
ECHOLENS_MAX_UPLOAD_MB=100
ECHOLENS_MAX_AUDIO_SECONDS=300

# Jetons personnels : sur Kaggle, utiliser Kaggle Secrets plutôt que ce fichier.
HF_TOKEN=
WANDB_API_KEY=

# Instance publique (Codespaces, serveur) : mot de passe demandé pour tout le site (S6).
# Vide : pas de mot de passe (usage local).
ECHOLENS_ACCESS_PASSWORD=
